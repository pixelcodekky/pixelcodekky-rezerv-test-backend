{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Rezerv": "Debug"
      }
    },
    "WriteTo": {
      "Seq": {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=rezerv;User=root;Password={YOUR_MYSQL_PASSWORD};",
    "RedisConnection": "localhost:6380"
  },
  "_2C2P": {
    "BaseUrl": "https://sandbox-pgw.2c2p.com",
    "MerchantId": "{YOUR_MERCHANT_ID}",
    "SecretKey": "{YOUR_SECRET_KEY}",
    "FrontendReturnUrl": "http://your-frontend-url/result/{invoiceNo}",
    "BackendReturnUrl": "https://your-public-tunnel-domain/api/payments/2c2p/notification",
    "Locale": "en",
    "TimeoutSeconds": 30,
    "PaymentAction": {
      "Url": "https://demo2.2c2p.com/PaymentAction/2.0/action",
      "Version": "4.3",
      "MerchantPrivateKeyPath": "",
      "MerchantPrivateKeyPassword": "",
      "TwoC2PPublicKeyPath": "",
      "Simulate": true
    }
  },
  "Checkout": {
    "LockTtl": "00:02:00",
    "WaitTimeout": "00:00:10",
    "WaitPollInterval": "00:00:00.200",
    "ResponseTtl": "1.00:00:00",
    "InquiryThrottle": "00:00:05",
    "CatalogCacheTtl": "00:10:00"
  }
}